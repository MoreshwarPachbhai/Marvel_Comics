# ==============================================================================
# ComicVerse - Environment Variables Configuration
# ==============================================================================

# Server Port (for local development only, Vercel manages this automatically)
PORT=8080

# Google Drive Root Folder ID containing your comic library folders
# Ensure the folder sharing permission is set to: "Anyone with the link can view"
DRIVE_ROOT_FOLDER_ID=1nNfIuaDIPxQSfHXciqo3nfGrv1owE7hB

# Allowed origins for CORS (comma-separated; optional for same-origin Vercel deployment)
CLIENT_ORIGIN=http://localhost:5173

# Library cache duration in seconds
CACHE_TTL_SECONDS=300

# Optional: Google Service Account JSON (single-line JSON string)
# Only required if you wish to use private Google Cloud API credentials instead of public Drive sharing
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional: Frontend API Base URL (leave blank in production for relative same-origin /api requests)
# VITE_API_BASE_URL=
